{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/candidati",
      "destination": "https://partner.ktsadvisory.it/partner",
      "permanent": false
    },
    {
      "source": "/candidati/",
      "destination": "https://partner.ktsadvisory.it/partner",
      "permanent": false
    },
    {
      "source": "/partner",
      "destination": "https://partner.ktsadvisory.it/partner",
      "permanent": false
    },
    {
      "source": "/partner/",
      "destination": "https://partner.ktsadvisory.it/partner",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ]
}
